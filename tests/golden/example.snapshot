# Generated by pkggen, edit packages/rpm-based/untitled-imgui-framework/spec.tmpl instead
# UVKBuildTool builds with its own flags, so there's no debug information to package
%global debug_package %{nil}
Name:           untitled-imgui-framework
Version:        2.5.0.1
Release:        1%{?dist}
Summary:        Cross-platform desktop application framework based on dear imgui
License:        MIT
URL:            https://github.com/MadLadSquad/UntitledImGuiFramework
Source0:        https://github.com/MadLadSquad/UntitledImGuiFramework/releases/download/v2.5.0.1/untitled-imgui-framework-2.5.0.1.tar.xz#/untitled-imgui-framework-2.5.0.1.tar.xz
ExclusiveArch:  %{?x86_64}%{!?x86_64:x86_64} aarch64

BuildRequires:  gcc-c++
BuildRequires:  make
BuildRequires:  cmake
BuildRequires:  pkgconfig
BuildRequires:  vulkan-headers
BuildRequires:  glfw-devel >= 3.4
BuildRequires:  fontconfig-devel
BuildRequires:  libglvnd-devel
BuildRequires:  wayland-devel
BuildRequires:  libX11-devel
BuildRequires:  libXrandr-devel
BuildRequires:  untitled-dbus-utils
BuildRequires:  untitled-cli-parser
BuildRequires:  untitled-exec
BuildRequires:  untitled-i18n
BuildRequires:  untitled-open
BuildRequires:  untitled-xdg-basedir
Requires:       vulkan-headers
Requires:       glfw-devel >= 3.4
Requires:       fontconfig-devel
Requires:       libglvnd-devel
Requires:       wayland-devel
Requires:       libX11-devel
Requires:       libXrandr-devel
Requires:       untitled-dbus-utils
Requires:       untitled-cli-parser
Requires:       untitled-exec
Requires:       untitled-i18n
Requires:       untitled-open
Requires:       untitled-xdg-basedir
%if 0%{?fedora}
BuildRequires:  utf8cpp-devel
BuildRequires:  vulkan-loader-devel
BuildRequires:  freetype-devel
Requires:       utf8cpp-devel
Requires:       vulkan-loader-devel
Requires:       freetype-devel
%endif
%if 0%{?suse_version}
BuildRequires:  utfcpp-devel
BuildRequires:  vulkan-devel
BuildRequires:  freetype2-devel
Requires:       utfcpp-devel
Requires:       vulkan-devel
Requires:       freetype2-devel
%endif

%description
Cross-platform desktop application framework based on dear imgui.

%prep
%autosetup -n untitled-imgui-framework-2.5.0.1
# The framework's pkg-config file, in the system's library directory
sed -i 's|^libdir=.*|libdir="${prefix}/%{_lib}"|' Framework/cmake/UntitledImGuiFramework.pc.in
sed -i 's|DESTINATION lib/pkgconfig/|DESTINATION %{_lib}/pkgconfig/|' \
	UVKBuildTool/Templates/UntitledImGuiFramework/BuildFiles/CMakeInstall.tmpl
# The build scripts run make with one job per CPU, which can run out of
# memory: let UIMGUI_JOBS set the count (the installed export.sh too, which
# builds the applications)
sed -i 's/^\([[:space:]]*\)\(cpus\|jobs\)=\$(grep -c processor .*$/&\n\1[ -z "${UIMGUI_JOBS}" ] || \2="${UIMGUI_JOBS}"/' \
	install.sh export.sh create-project.sh UVKBuildTool/ci.sh
grep -q UIMGUI_JOBS export.sh

%build
# Configures a UVKBuildTool project (its uvproj.yaml) for a system-wide build
# against the system's framework, with every library in %%{_libdir}
# (upstream assumes lib64/). The directories are compiled into the application.
configure_project() {
	file=$1 framework=${2:-false}
	sed -i \
		-e 's|lib64/|%{_lib}/|g' \
		-e '/^build-mode-vendor:/d' \
		-e '/^system-wide:/d' \
		-e '/^install-framework:/d' \
		"$file"
	if grep -q '^install-override:' "$file"; then
		sed -i '/^install-override:/,/^[^ ]/ s|^  unix:$|  unix:\n    framework-library-dir: "%{_lib}/"\n    framework-application-library-dir: "%{_lib}/"|' "$file"
	else
		printf 'install-override:\n  unix:\n    framework-library-dir: "%{_lib}/"\n    framework-application-library-dir: "%{_lib}/"\n' >> "$file"
	fi
	printf 'build-mode-vendor: false\nsystem-wide: true\ninstall-framework: %%s\n' "$framework" >> "$file"
}

export UIMGUI_JOBS=%{_smp_build_ncpus}
# Builds UVKBuildTool in UVKBuildTool/build
./install.sh ci
# The empty project that installs the framework
./create-project.sh pkg --skip-compilation
configure_project Projects/pkg/uvproj.yaml true

# UVKBuildTool itself, built again for its system-wide location
cmake -B uvkbuildtool -S UVKBuildTool \
	-DCMAKE_BUILD_TYPE=Release \
	-DCMAKE_INSTALL_PREFIX=%{_prefix} \
	-DUBT_INSTALL=ON \
	-DUBT_FRAMEWORK_DIR=%{_includedir}/UntitledImGuiFramework/ \
	-DUBT_DATA_INSTALL_PREFIX=%{_datadir}/
cmake --build uvkbuildtool %{?_smp_mflags}

%install
# UVKBuildTool exits with 0 even when the build fails: fail when the project's
# library (lib<name>Lib.so, <name> from uvproj.yaml) wasn't installed
check_installed() {
	name=$(sed -n 's/^name: *"\{0,1\}\([^"]*\)"\{0,1\} *$/\1/p' "$1" | head -n 1)
	if [ ! -e "$2/lib${name}Lib.so" ]; then
		echo "UVKBuildTool didn't install lib${name}Lib.so, so the build failed (see above)" >&2
		exit 1
	fi
}

export UIMGUI_JOBS=%{_smp_build_ncpus}
# The framework looks for <wayland-client.h> without pkg-config's flags, and
# openSUSE keeps it in %%{_includedir}/wayland
export CPATH="$(pkg-config --variable=includedir wayland-client)${CPATH:+:$CPATH}"
(cd UVKBuildTool/build && ./UVKBuildTool --build %{buildroot}%{_prefix} %{_prefix} ../../Projects/pkg)
check_installed Projects/pkg/uvproj.yaml %{buildroot}%{_libdir}
test -e %{buildroot}%{_libdir}/libUntitledImGuiFramework.so
# Only keep the framework, not the project that installed it
rm -rf %{buildroot}%{_libdir}/libpkgLib.so %{buildroot}%{_bindir}/pkg %{buildroot}%{_datadir}/config/pkg \
	%{buildroot}%{_includedir}/pkg %{buildroot}%{_includedir}/utf8cpp %{buildroot}%{_datadir}/utf8cpp

DESTDIR=%{buildroot} cmake --install uvkbuildtool

%files
%license LICENSE
%{_libdir}/libUntitledImGuiFramework.so
%{_libdir}/pkgconfig/UntitledImGuiFramework.pc
%{_includedir}/UntitledImGuiFramework/
%{_bindir}/UVKBuildTool
%{_datadir}/UVKBuildTool/

%changelog
