# Copyright 2022 - 2027 MadLadSquad
# Distributed under the terms of the MIT License
# Generated by pkggen, edit packages/gentoo/cmake-library/ebuild.tmpl instead

EAPI=8

inherit cmake

DESCRIPTION="C and C++ implementation of the XDG base directory specification"
HOMEPAGE="https://github.com/MadLadSquad/UntitledXDGBasedir"
SRC_URI="
	https://github.com/MadLadSquad/UntitledXDGBasedir/releases/download/v6.0.0.0/untitled-xdg-basedir-6.0.0.0.tar.xz -> untitled-xdg-basedir-6.0.0.0.tar.xz
"
S="${WORKDIR}/${P}"

LICENSE="MIT"
SLOT="0"
KEYWORDS="~amd64 ~arm64"
IUSE="create_dirs +ignore_relative_dirs"

BDEPEND="dev-build/cmake
	virtual/pkgconfig"

src_prepare() {
	# Older releases install the library to lib64/ and their pkg-config file
	# to lib/: use CMake's standard library directory for both, like newer ones do
	if ! grep -q 'include(GNUInstallDirs)' CMakeLists.txt; then
		sed -i '0,/^project(/s|^\(project(.*\)$|\1\ninclude(GNUInstallDirs)|' CMakeLists.txt || die
	fi
	sed -i \
		-e 's|DESTINATION lib64/|DESTINATION ${CMAKE_INSTALL_LIBDIR}/|g' \
		-e 's|DESTINATION lib/pkgconfig/|DESTINATION ${CMAKE_INSTALL_LIBDIR}/pkgconfig/|g' \
		CMakeLists.txt || die
	sed -i 's|^libdir=.*|libdir="@CMAKE_INSTALL_FULL_LIBDIR@"|' ./*.pc.in || die
	cmake_src_prepare
}

src_configure() {
	local mycmakeargs=(
		-DUIMGUI_INSTALL=ON
		"-DCREATE_DIRS=$(usex create_dirs)"
		"-DNO_IGNORE_RELATIVE_DIRS=$(usex ignore_relative_dirs OFF ON)"
	)
	cmake_src_configure
}

