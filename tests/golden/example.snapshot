export DEB_BUILD_MAINT_OPTIONS = hardening=+all
# The framework's build scripts run make with this many jobs (parallel=N in
# DEB_BUILD_OPTIONS; one without it, as Debian policy asks)
export UIMGUI_JOBS = $(or $(DEB_BUILD_OPTION_PARALLEL),1)
LIBDIR = lib/$(DEB_HOST_MULTIARCH)
DESTDIR = $(CURDIR)/debian/untitled-imgui-framework

%:
	dh $@

# The framework's pkg-config file, in the multiarch directory
override_dh_auto_configure:
	sed -i 's|^libdir=.*|libdir="$${prefix}/$(LIBDIR)"|' Framework/cmake/UntitledImGuiFramework.pc.in
	sed -i 's|DESTINATION lib/pkgconfig/|DESTINATION $(LIBDIR)/pkgconfig/|' \
		UVKBuildTool/Templates/UntitledImGuiFramework/BuildFiles/CMakeInstall.tmpl
	# The build scripts use one job per CPU, which can run out of memory:
	# let UIMGUI_JOBS set the count (the installed export.sh too, which builds
	# the applications)
	sed -i 's/^\([[:space:]]*\)\(cpus\|jobs\)=\$$(grep -c processor .*$$/&\n\1[ -z "$${UIMGUI_JOBS}" ] || \2="$${UIMGUI_JOBS}"/' \
		install.sh export.sh create-project.sh UVKBuildTool/ci.sh
	grep -q UIMGUI_JOBS export.sh

override_dh_auto_build:
	# Builds UVKBuildTool in UVKBuildTool/build
	./install.sh ci
	# The empty project that installs the framework
	./create-project.sh pkg --skip-compilation
	sh debian/uimgui.sh configure Projects/pkg/uvproj.yaml $(LIBDIR) true
	# UVKBuildTool itself, built again for its system-wide location
	cmake -B debian/uvkbuildtool -S UVKBuildTool \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DUBT_INSTALL=ON \
		-DUBT_FRAMEWORK_DIR=/usr/include/UntitledImGuiFramework/ \
		-DUBT_DATA_INSTALL_PREFIX=/usr/share/
	cmake --build debian/uvkbuildtool --parallel $(UIMGUI_JOBS)

override_dh_auto_install:
	cd UVKBuildTool/build && ./UVKBuildTool --build $(DESTDIR)/usr /usr ../../Projects/pkg
	sh debian/uimgui.sh check Projects/pkg/uvproj.yaml $(DESTDIR)/usr/$(LIBDIR)
	test -e $(DESTDIR)/usr/$(LIBDIR)/libUntitledImGuiFramework.so
	# Only keep the framework, not the project that installed it
	rm -rf $(DESTDIR)/usr/$(LIBDIR)/libpkgLib.so $(DESTDIR)/usr/bin/pkg $(DESTDIR)/usr/share/config/pkg \
		$(DESTDIR)/usr/include/pkg $(DESTDIR)/usr/include/utf8cpp $(DESTDIR)/usr/share/utf8cpp
	DESTDIR=$(DESTDIR) cmake --install debian/uvkbuildtool

override_dh_auto_test:

# dh_fixperms makes everything in /usr/include 0644, but UVKBuildTool runs the
# framework's export.sh from there to build applications
override_dh_fixperms:
	dh_fixperms
	find $(DESTDIR)/usr/include/UntitledImGuiFramework -name '*.sh' -exec chmod 0755 {} +

override_dh_auto_clean:
	rm -rf debian/uvkbuildtool UVKBuildTool/build Projects

# The UntitledDesktop libraries have no SONAME yet, so they have no shlibs file
override_dh_shlibdeps:
	dh_shlibdeps -- --ignore-missing-info

# UVKBuildTool builds without debug information
override_dh_dwz:

==> debian/packages/untitled-imgui-framework/debian/uimgui.sh (1548 bytes)
#!/bin/sh
# Helpers for UVKBuildTool projects, called from debian/rules:
#   sh debian/uimgui.sh configure <uvproj.yaml> <libdir> [install-framework]
#   sh debian/uimgui.sh check <uvproj.yaml> <installed library directory>
set -e

case "$1" in
configure)
	# A system-wide build against the system's framework, with every library
	# in the multiarch directory (upstream assumes lib64/). The directories are
	# compiled into the application.
	file=$2 libdir=$3 framework=${4:-false}
	sed -i \
		-e "s|lib64/|$libdir/|g" \
		-e '/^build-mode-vendor:/d' \
		-e '/^system-wide:/d' \
		-e '/^install-framework:/d' \
		"$file"
	if grep -q '^install-override:' "$file"; then
		sed -i "/^install-override:/,/^[^ ]/ s|^  unix:\$|  unix:\n    framework-library-dir: \"$libdir/\"\n    framework-application-library-dir: \"$libdir/\"|" "$file"
	else
		printf 'install-override:\n  unix:\n    framework-library-dir: "%s/"\n    framework-application-library-dir: "%s/"\n' "$libdir" "$libdir" >> "$file"
	fi
	printf 'build-mode-vendor: false\nsystem-wide: true\ninstall-framework: %s\n' "$framework" >> "$file"
	;;
check)
	# UVKBuildTool exits with 0 even when the build fails: fail when the
	# project's library (lib<name>Lib.so, <name> from uvproj.yaml) wasn't installed
	name=$(sed -n 's/^name: *"\{0,1\}\([^"]*\)"\{0,1\} *$/\1/p' "$2" | head -n 1)
	if [ ! -e "$3/lib${name}Lib.so" ]; then
		echo "UVKBuildTool didn't install lib${name}Lib.so, so the build failed (see above)" >&2
		exit 1
	fi
	;;
*)
	echo "usage: $0 configure|check ..." >&2
	exit 2
	;;
esac

