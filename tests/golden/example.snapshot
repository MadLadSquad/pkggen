==> alpine/index.html (4703 bytes)
<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<meta name="description" content="The official Alpine Linux repository for the UntitledDesktopEnvironment and related projects.">
		<meta name="author" content="MadLadSquad">
		<link rel="icon" type="image/png" href="./favicon.png">
		<title>UntitledDesktop APK Repository</title>

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Ubuntu&display=swap" rel="stylesheet" type="text/css">

		<style>
			body {
				background-color: #E8EEF2;
				color: #37293A;
				max-width: 1360px;
			}
			h1, h2, h3, h4, h5, h6, p, a, li {
				font-family: Ubuntu, sans-serif;
			}

			a {
				text-decoration: none;
				color: #1d84b5;
			}

			.inline-code {
				display: inline;
				border: 1px solid #37293A;
				border-radius: 0.25rem;
				background-color: #37293A;
				color: #e8eef2;
				padding-left: 0.25rem;
				padding-right: 0.25rem;
			}
		</style>
	</head>
	<body>
		<h1>Welcome to the UntitledDesktopEnvironment Alpine Linux repository</h1>
		<p>This repository is used for hosting all UntitledDesktopEnvironment packages, as well as all <a href="https://madladsquad.com">MadLadSquad</a> applications, for Alpine Linux.</p>

		<p>Packages are built for Alpine Linux edge, 3.24 and 3.23, for x86_64 and aarch64. The packages and the indexes are signed with our RSA key: download it into <code class="inline-code">/etc/apk/keys/</code>, so apk trusts the repository:</p>
		<pre class="sourceCode language-bash"><code class="sourceCode language-bash">wget -O /etc/apk/keys/madladsquad.rsa.pub https://apks.madladsquad.com/madladsquad.rsa.pub</code></pre>

		<p>Then add the repository of your release to <code class="inline-code">/etc/apk/repositories</code> (<code class="inline-code">alpine-edge</code>, <code class="inline-code">alpine-3.24</code> or <code class="inline-code">alpine-3.23</code>) and install the packages:</p>
		<pre class="sourceCode language-bash"><code class="sourceCode language-bash">echo "https://apks.madladsquad.com/alpine-3.24" >> /etc/apk/repositories
apk update
apk add untitled-imgui-framework</code></pre>

		<h2>Available packages:</h2>
		<ul>
			<li>untitled-game-system-manager - Provides <a href="https://github.com/MadLadSquad/UntitledGameSystemManager">UntitledGameSystemManager</a>, a manager for containerised Linux game systems</li>
			<li>untitled-ibus-handwriting - Provides <a href="https://github.com/MadLadSquad/UntitledIBusHandwriting">UntitledIBusHandwriting</a>, an IBus handwriting input method for IBus</li>
			<li>ude-session-logout - Provides <a href="https://github.com/MadLadSquad/UntitledDESessionLogout">UntitledDESessionLogout</a>, a session logout utility for the UntitledDesktopEnvironment</li>
			<li>untitled-imgui-framework - Provides <a href="https://github.com/MadLadSquad/UntitledImGuiFramework">UntitledImGuiFramework</a>, an independent cross-platform desktop application development toolkit</li>
			<li>untitled-dbus-utils - Provides <a href="https://github.com/MadLadSquad/UntitledDBusUtils">UntitledDBusUtils</a>, a C++ wrapper on top of the low level D-Bus C API</li>
			<li>untitled-exec - Provides <a href="https://github.com/MadLadSquad/UntitledExec">UntitledExec</a>, a cross-platform fork and exec/CreateProcess wrapper library</li>
			<li>untitled-cli-parser - Provides <a href="https://github.com/MadLadSquad/UntitledCLIParser">UntitledCLIParser</a>, a parser for CLI arguments</li>
			<li>untitled-i18n - Provides <a href="https://github.com/MadLadSquad/UntitledI18N">UntitledI18N</a>, a i18n library</li>
			<li>untitled-open - Provides <a href="https://github.com/MadLadSquad/UntitledOpen">UntitledOpen</a>, a file dialog, URL and file opener library</li>
			<li>untitled-xdg-basedir - Provides <a href="https://github.com/MadLadSquad/UntitledXDGBasedir">UntitledXDGBasedir</a>, a better implementation of the XDG base directory specification</li>
		</ul>
		<footer>
			<p>A <a href="https://madladsquad.com">MadLadSquad</a> / <a href="https://heapforge.com">Heapforge</a> project. Copyright &#169; <a href="https://heapforge.com">Heapforge Ltd.</a> 2025 - 2026 &bull; <a href="https://madladsquad.com/privacy-policy">Privacy Policy</a>.</p>
		</footer>
	</body>
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.8.0/styles/atom-one-dark-reasonable.min.css">
	<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.8.0/highlight.min.js"></script>
	<script>hljs.highlightAll();</script>
</html>


==> alpine/ude-session-logout/APKBUILD (3152 bytes)
# Maintainer: MadLadSquad <contact@madladsquad.com>
# Generated by pkggen, edit packages/alpine/uimgui-app/APKBUILD.tmpl instead
maintainer="MadLadSquad <contact@madladsquad.com>"
pkgname=ude-session-logout
pkgver=2.3.0.0
pkgrel=0
pkgdesc="A log out prompt for the UntitledDesktopEnvironment"
url="https://github.com/MadLadSquad/UntitledDESessionLogout"
arch="x86_64 aarch64"
license="MIT"
depends="untitled-imgui-framework"
makedepends="sed cmake pkgconf untitled-imgui-framework"
# Upstream has no tests
options="!check"
source="
	ude-session-logout-2.3.0.0.tar.xz::https://github.com/MadLadSquad/UntitledDESessionLogout/releases/download/v2.3.0.0/ude-session-logout-2.3.0.0.tar.xz
	"
builddir="$srcdir"/"ude-session-logout-2.3.0.0"

# Configures a UVKBuildTool project (its uvproj.yaml) for a system-wide build
# against the system's framework. Upstream installs libraries to lib64/, which
# abuild rejects, so everything goes to lib/ instead. The directories are
# compiled into the application. abuild runs this with busybox sh: no bashisms.
_configure_project() {
	local file="$1" framework="${2:-false}"
	sed -i \
		-e 's|lib64/|lib/|g' \
		-e '/^build-mode-vendor:/d' \
		-e '/^system-wide:/d' \
		-e '/^install-framework:/d' \
		"$file"
	if grep -q '^install-override:' "$file"; then
		sed -i '/^install-override:/,/^[^ ]/ s|^  unix:$|  unix:\n    framework-library-dir: "lib/"\n    framework-application-library-dir: "lib/"|' "$file"
	else
		printf 'install-override:\n  unix:\n    framework-library-dir: "lib/"\n    framework-application-library-dir: "lib/"\n' >> "$file"
	fi
	printf 'build-mode-vendor: false\nsystem-wide: true\ninstall-framework: %s\n' "$framework" >> "$file"
}

# The job count abuild's MAKEFLAGS asks for (JOBS in abuild.conf), for
# UIMGUI_JOBS (the framework's scripts otherwise use every CPU). Empty without one.
_make_jobs() {
	printf '%s\n' "$MAKEFLAGS" | sed -n 's/.*-j *\([0-9][0-9]*\).*/\1/p'
}

# UVKBuildTool exits with 0 even when the build fails: fail when the project's
# library (lib<name>Lib.so, <name> from uvproj.yaml) wasn't installed
_check_installed() {
	local name
	name=$(sed -n 's/^name: *"\{0,1\}\([^"]*\)"\{0,1\} *$/\1/p' "$1" | head -n 1)
	if [ ! -e "$2/lib${name}Lib.so" ]; then
		echo "UVKBuildTool didn't install lib${name}Lib.so, so the build failed (see above)" >&2
		return 1
	fi
}

build() {
	# abuild makes CMake use Ninja, but UVKBuildTool runs make
	export CMAKE_GENERATOR="Unix Makefiles"
	UVKBuildTool --generate "$builddir"
	_configure_project uvproj.yaml
}

package() {
	# UVKBuildTool compiles and installs in one step
	export CMAKE_GENERATOR="Unix Makefiles"
	export UIMGUI_JOBS="$(_make_jobs)"
	UVKBuildTool --build "$pkgdir/usr" /usr "$builddir"
	_check_installed uvproj.yaml "$pkgdir/usr/lib"
	# The framework's copy of utfcpp comes from the utfcpp package
	rm -rf "$pkgdir"/usr/include/utf8cpp "$pkgdir"/usr/share/utf8cpp
	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}

sha512sums="
1c853c10de2d2d3d7d87617eb796f445e7b322a8d1075b82f404cf638e0e3709145c00916a4e28729e95855265abf585ffcce91d2f8b321a8c1af365ad4e2410  ude-session-logout-2.3.0.0.tar.xz
"

==> alpine/untitled-cli-parser/APKBUILD (2078 bytes)
# Maintainer: MadLadSquad <contact@madladsquad.com>
# Generated by pkggen, edit packages/alpine/cmake-library/APKBUILD.tmpl instead
maintainer="MadLadSquad <contact@madladsquad.com>"
pkgname=untitled-cli-parser
pkgver=6.1.0.0
pkgrel=0
pkgdesc="C and C++ parser for CLI arguments"
url="https://github.com/MadLadSquad/UntitledCLIParser"
arch="x86_64 aarch64"
license="MIT"
depends=""
makedepends="sed samurai cmake pkgconf"
# Upstream has no tests
options="!check"
source="
	untitled-cli-parser-6.1.0.0.tar.xz::https://github.com/MadLadSquad/UntitledCLIParser/releases/download/v6.1.0.0/untitled-cli-parser-6.1.0.0.tar.xz
	"
builddir="$srcdir"/"untitled-cli-parser-6.1.0.0"

prepare() {
	default_prepare
	# Older releases install the library to lib64/ and their pkg-config file
	# to lib/: use CMake's standard library directory for both, like newer ones do
	grep -q 'include(GNUInstallDirs)' CMakeLists.txt ||
		sed -i '0,/^project(/s|^\(project(.*\)$|\1\ninclude(GNUInstallDirs)|' CMakeLists.txt
	sed -i \
		-e 's|DESTINATION lib64/|DESTINATION ${CMAKE_INSTALL_LIBDIR}/|g' \
		-e 's|DESTINATION lib/pkgconfig/|DESTINATION ${CMAKE_INSTALL_LIBDIR}/pkgconfig/|g' \
		CMakeLists.txt
	sed -i 's|^libdir=.*|libdir="@CMAKE_INSTALL_FULL_LIBDIR@"|' ./*.pc.in
	# UntitledExec's uexecdata.h uses pid_t and size_t without their headers, which
	# glibc pulls in through others but musl doesn't
	if [ -f uexecdata.h ] && ! grep -q 'sys/types.h' uexecdata.h; then
		sed -i 's|^\([[:space:]]*\)#include <stdbool.h>|&\n\1#include <stddef.h>\n\1#include <sys/types.h>|' uexecdata.h
		grep -q 'sys/types.h' uexecdata.h
	fi
}

build() {
	cmake -B build \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DUIMGUI_INSTALL=ON
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}

sha512sums="
276f3603bf80f1d9b621a16c88d23e2346921c2fd956046bf9a35fa8d0eae6faab11c89e4cb52be9bcd86e70fd3951e484c3da64059304b0636330bac1101a3f  untitled-cli-parser-6.1.0.0.tar.xz
"

