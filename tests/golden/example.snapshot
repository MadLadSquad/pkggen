makedepends="sed bash cmake pkgconf utfcpp vulkan-headers vulkan-loader-dev glfw-dev>=3.4 freetype-dev fontconfig-dev mesa-dev wayland-dev libx11-dev libxrandr-dev untitled-dbus-utils untitled-cli-parser untitled-exec untitled-i18n untitled-open untitled-xdg-basedir"
