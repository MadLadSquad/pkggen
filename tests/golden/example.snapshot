# Copyright 2022 - 2027 MadLadSquad
# Distributed under the terms of the MIT License
# Generated by pkggen, edit packages/gentoo/btrustbiss/ebuild.tmpl instead

EAPI=8

inherit desktop rpm xdg

DESCRIPTION="B-Trust Browser Independent Signing Service, for signing files with a qualified electronic signature"
HOMEPAGE="https://www.b-trust.bg/services/software"
SRC_URI="
	https://www.b-trust.bg/attachments/BtrustPrivateFile/146/docs/B-TrustBISS.tar -> B-TrustBISS-3.46.tar
"
S="${WORKDIR}"

LICENSE="B-Trust-EULA"
SLOT="0"
KEYWORDS="-* ~amd64"
RESTRICT="bindist mirror strip"
QA_PREBUILT="opt/btrustbiss/*"


src_unpack() {
	default
	rpm_unpack ./"${P}"-*.rpm
}

src_install() {
	# Keep the bundle as it is, with its permissions
	dodir /opt
	cp -a opt/btrustbiss "${ED}/opt/" || die
	dosym -r /opt/btrustbiss/bin/BISS /usr/bin/BISS
	doicon opt/btrustbiss/lib/BISS.png
	# Upstream's menu entry has Categories=Unknown, which isn't a valid category
	sed -i 's/^Categories=Unknown;\{0,1\}$/Categories=Utility;Security;/' \
		opt/btrustbiss/lib/btrustbiss-BISS.desktop || die
	domenu opt/btrustbiss/lib/btrustbiss-BISS.desktop
}

