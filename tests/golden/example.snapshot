==> rpm-based/SPECS/ude-session-logout.spec (3075 bytes)
# Generated by pkggen, edit packages/rpm-based/uimgui-app/spec.tmpl instead
# UVKBuildTool builds with its own flags, so there's no debug information to package
%global debug_package %{nil}
Name:           ude-session-logout
Version:        2.3.0.0
Release:        1%{?dist}
Summary:        A log out prompt for the UntitledDesktopEnvironment
License:        MIT
URL:            https://github.com/MadLadSquad/UntitledDESessionLogout
Source0:        https://github.com/MadLadSquad/UntitledDESessionLogout/releases/download/v2.3.0.0/ude-session-logout-2.3.0.0.tar.xz#/ude-session-logout-2.3.0.0.tar.xz
ExclusiveArch:  %{?x86_64}%{!?x86_64:x86_64} aarch64

BuildRequires:  gcc-c++
BuildRequires:  make
BuildRequires:  cmake
BuildRequires:  pkgconfig
BuildRequires:  untitled-imgui-framework
Requires:       untitled-imgui-framework

%description
A log out prompt for the UntitledDesktopEnvironment.

%prep
%autosetup -n ude-session-logout-2.3.0.0

%build
# Configures a UVKBuildTool project (its uvproj.yaml) for a system-wide build
# against the system's framework, with every library in %%{_libdir}
# (upstream assumes lib64/). The directories are compiled into the application.
configure_project() {
	file=$1 framework=${2:-false}
	sed -i \
		-e 's|lib64/|%{_lib}/|g' \
		-e '/^build-mode-vendor:/d' \
		-e '/^system-wide:/d' \
		-e '/^install-framework:/d' \
		"$file"
	if grep -q '^install-override:' "$file"; then
		sed -i '/^install-override:/,/^[^ ]/ s|^  unix:$|  unix:\n    framework-library-dir: "%{_lib}/"\n    framework-application-library-dir: "%{_lib}/"|' "$file"
	else
		printf 'install-override:\n  unix:\n    framework-library-dir: "%{_lib}/"\n    framework-application-library-dir: "%{_lib}/"\n' >> "$file"
	fi
	printf 'build-mode-vendor: false\nsystem-wide: true\ninstall-framework: %%s\n' "$framework" >> "$file"
}

UVKBuildTool --generate "$PWD"
configure_project uvproj.yaml

%install
# UVKBuildTool exits with 0 even when the build fails: fail when the project's
# library (lib<name>Lib.so, <name> from uvproj.yaml) wasn't installed
check_installed() {
	name=$(sed -n 's/^name: *"\{0,1\}\([^"]*\)"\{0,1\} *$/\1/p' "$1" | head -n 1)
	if [ ! -e "$2/lib${name}Lib.so" ]; then
		echo "UVKBuildTool didn't install lib${name}Lib.so, so the build failed (see above)" >&2
		exit 1
	fi
}

# UVKBuildTool compiles and installs in one step, with the framework's
# build script, which uses UIMGUI_JOBS jobs
export UIMGUI_JOBS=%{_smp_build_ncpus}
UVKBuildTool --build %{buildroot}%{_prefix} %{_prefix} "$PWD"
check_installed uvproj.yaml %{buildroot}%{_libdir}
# The framework's copy of utfcpp comes from the system
rm -rf %{buildroot}%{_includedir}/utf8cpp %{buildroot}%{_datadir}/utf8cpp

%files
%license LICENSE
%{_bindir}/ude-session-logout
%{_libdir}/libude-session-logoutLib.so
%{_datadir}/config/ude-session-logout/
%{_includedir}/ude-session-logout/
%{_datadir}/applications/com.madladsquad.ude-session-logout.desktop
%{_datadir}/icons/ude-session-logout.png

%changelog
* Tue Sep 01 2026 MadLadSquad <contact@madladsquad.com> - 2.3.0.0-1
- Update to 2.3.0.0

