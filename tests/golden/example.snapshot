# Maintainer: MadLadSquad <contact@madladsquad.com>
# Generated by pkggen, edit packages/arch/cmake-library/PKGBUILD.tmpl instead

pkgname=untitled-open
pkgver=3.0.1.0
pkgrel=1
pkgdesc="Cross-platform C and C++ library for opening links and native file pickers"
arch=('x86_64' 'aarch64')
url="https://github.com/MadLadSquad/UntitledOpen"
license=('MIT')
depends=('gcc-libs' 'glibc' 'dbus' 'wayland' 'xdg-desktop-portal')
makedepends=('cmake' 'pkgconf')
source=(
	"untitled-open-3.0.1.0.tar.xz::https://github.com/MadLadSquad/UntitledOpen/releases/download/v3.0.1.0/untitled-open-3.0.1.0.tar.xz"
)
sha256sums=(
	'2c631ec09e14d7424d489e76215bdbd139025e776eca7e30a037098da543f74f'
)

prepare() {
	cd "$srcdir/untitled-open-3.0.1.0"
	# Older releases install the library to lib64/ and their pkg-config file
	# to lib/: use CMake's standard library directory for both, like newer ones do
	grep -q 'include(GNUInstallDirs)' CMakeLists.txt ||
		sed -i '0,/^project(/s|^\(project(.*\)$|\1\ninclude(GNUInstallDirs)|' CMakeLists.txt
	sed -i \
		-e 's|DESTINATION lib64/|DESTINATION ${CMAKE_INSTALL_LIBDIR}/|g' \
		-e 's|DESTINATION lib/pkgconfig/|DESTINATION ${CMAKE_INSTALL_LIBDIR}/pkgconfig/|g' \
		CMakeLists.txt
	sed -i 's|^libdir=.*|libdir="@CMAKE_INSTALL_FULL_LIBDIR@"|' ./*.pc.in
}

build() {
	cmake -B build -S "$srcdir/untitled-open-3.0.1.0" \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DUIMGUI_INSTALL=ON \
		'-DBUILD_SHARED_LIBS=OFF'
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	install -Dm644 "$srcdir/untitled-open-3.0.1.0/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

