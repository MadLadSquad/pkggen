# Maintainer: MadLadSquad <contact@madladsquad.com>
# Generated by pkggen, edit packages/arch/untitled-game-system-manager/PKGBUILD.tmpl instead

pkgname=untitled-game-system-manager
pkgver=2.9.1.0
pkgrel=1
pkgdesc="A manager for containerised Linux gaming systems based on Incus"
arch=('x86_64' 'aarch64')
url="https://github.com/MadLadSquad/UntitledGameSystemManager"
license=('MIT')
depends=('incus' 'xorg-xhost' 'untitled-imgui-framework')
makedepends=('cmake' 'pkgconf' 'go>=1.25')
# The Go part is a shared library, which makepkg's LTO flags break
options=('!lto')
source=(
	"untitled-game-system-manager-2.9.1.0.tar.xz::https://github.com/MadLadSquad/UntitledGameSystemManager/releases/download/v2.9.1.0/untitled-game-system-manager-2.9.1.0.tar.xz"
)
sha256sums=(
	'7958afcc9c67a47e0f74ce70eb16e6ee8265589c2c669d57f255431558c91f99'
)

# Configures a UVKBuildTool project (its uvproj.yaml) for a system-wide build
# against the system's framework. Upstream installs libraries to lib64/, which
# is a symlink owned by the filesystem package on Arch, so everything goes to
# lib/ instead. The directories are compiled into the application.
_configure_project() {
	local file=$1 framework=${2:-false}
	sed -i \
		-e 's|lib64/|lib/|g' \
		-e '/^build-mode-vendor:/d' \
		-e '/^system-wide:/d' \
		-e '/^install-framework:/d' \
		"$file"
	if grep -q '^install-override:' "$file"; then
		sed -i '/^install-override:/,/^[^ ]/ s|^  unix:$|  unix:\n    framework-library-dir: "lib/"\n    framework-application-library-dir: "lib/"|' "$file"
	else
		printf 'install-override:\n  unix:\n    framework-library-dir: "lib/"\n    framework-application-library-dir: "lib/"\n' >> "$file"
	fi
	printf 'build-mode-vendor: false\nsystem-wide: true\ninstall-framework: %s\n' "$framework" >> "$file"
}

# The job count makepkg's MAKEFLAGS asks for, for UIMGUI_JOBS (the framework's
# scripts otherwise use every CPU, whatever MAKEFLAGS says). Empty without one.
_make_jobs() {
	printf '%s\n' "$MAKEFLAGS" | sed -n 's/.*-j *\([0-9][0-9]*\).*/\1/p'
}

# UVKBuildTool exits with 0 even when the build fails: fail when the project's
# library (lib<name>Lib.so, <name> from uvproj.yaml) wasn't installed
_check_installed() {
	local name
	name=$(sed -n 's/^name: *"\{0,1\}\([^"]*\)"\{0,1\} *$/\1/p' "$1" | head -n 1)
	if [ ! -e "$2/lib${name}Lib.so" ]; then
		echo "UVKBuildTool didn't install lib${name}Lib.so, so the build failed (see above)" >&2
		return 1
	fi
}

build() {
	cd "$srcdir/untitled-game-system-manager-2.9.1.0"
	# The Incus bindings: a C shared library written in Go, with vendored modules
	export CGO_CPPFLAGS="${CPPFLAGS}" CGO_CFLAGS="${CFLAGS}" CGO_CXXFLAGS="${CXXFLAGS}" CGO_LDFLAGS="${LDFLAGS}"
	(cd IncusBindings && go build -mod=vendor -trimpath -modcacherw -buildmode=c-shared \
		-o libUGM_Incus_InternalFuncs.so .)
	UVKBuildTool --generate "$srcdir/untitled-game-system-manager-2.9.1.0"
	_configure_project uvproj.yaml
}

package() {
	cd "$srcdir/untitled-game-system-manager-2.9.1.0"
	# UVKBuildTool compiles and installs in one step
	export UIMGUI_JOBS="$(_make_jobs)"
	UVKBuildTool --build "$pkgdir/usr" /usr "$srcdir/untitled-game-system-manager-2.9.1.0"
	_check_installed uvproj.yaml "$pkgdir/usr/lib"
	# The framework's copy of utfcpp comes from the utf8cpp package
	rm -rf "$pkgdir"/usr/{include,share}/utf8cpp
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

