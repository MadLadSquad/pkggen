nofixperms=yes
hostmakedepends="cmake pkgconf"
makedepends="utfcpp Vulkan-Headers vulkan-loader-devel glfw-devel freetype-devel fontconfig-devel libglvnd-devel wayland-devel libX11-devel libXrandr-devel untitled-dbus-utils untitled-cli-parser untitled-exec untitled-i18n untitled-open untitled-xdg-basedir"
depends="utfcpp Vulkan-Headers vulkan-loader-devel glfw-devel>=3.4 freetype-devel fontconfig-devel libglvnd-devel wayland-devel libX11-devel libXrandr-devel untitled-dbus-utils untitled-cli-parser untitled-exec untitled-i18n untitled-open untitled-xdg-basedir"
short_desc="Cross-platform desktop application framework based on dear imgui"
maintainer="MadLadSquad <contact@madladsquad.com>"
license="MIT"
homepage="https://github.com/MadLadSquad/UntitledImGuiFramework"
distfiles="https://github.com/MadLadSquad/UntitledImGuiFramework/releases/download/v2.5.0.1/untitled-imgui-framework-2.5.0.1.tar.xz>untitled-imgui-framework-2.5.0.1.tar.xz"
checksum="05552aebbc6ce8c14e1e134eeb6c19fd241cb02db2103ef2fc5a5564c22bbcf1"

# Configures a UVKBuildTool project (its uvproj.yaml) for a system-wide build
# against the system's framework. Upstream installs libraries to lib64/, a
# symlink to lib/ on Void, so everything goes to lib/ instead. The directories
# are compiled into the application.
_configure_project() {
	local file=$1 framework=${2:-false}
	sed -i \
		-e 's|lib64/|lib/|g' \
		-e '/^build-mode-vendor:/d' \
		-e '/^system-wide:/d' \
		-e '/^install-framework:/d' \
		"$file"
	if grep -q '^install-override:' "$file"; then
		sed -i '/^install-override:/,/^[^ ]/ s|^  unix:$|  unix:\n    framework-library-dir: "lib/"\n    framework-application-library-dir: "lib/"|' "$file"
	else
		printf 'install-override:\n  unix:\n    framework-library-dir: "lib/"\n    framework-application-library-dir: "lib/"\n' >> "$file"
	fi
	printf 'build-mode-vendor: false\nsystem-wide: true\ninstall-framework: %s\n' "$framework" >> "$file"
}

# UVKBuildTool exits with 0 even when the build fails: fail when the project's
# library (lib<name>Lib.so, <name> from uvproj.yaml) wasn't installed
_check_installed() {
	local name
	name=$(sed -n 's/^name: *"\{0,1\}\([^"]*\)"\{0,1\} *$/\1/p' "$1" | head -n 1)
	if [ ! -e "$2/lib${name}Lib.so" ]; then
		msg_error "UVKBuildTool didn't install lib${name}Lib.so, so the build failed (see above)\n"
	fi
}

pre_build() {
	# The framework's pkg-config file, in /usr/lib like the library
	sed -i 's|^libdir=.*|libdir="${prefix}/lib"|' Framework/cmake/UntitledImGuiFramework.pc.in
	# The build scripts run make with one job per CPU, which can run out of
	# memory: let UIMGUI_JOBS set the count (the installed export.sh too, which
	# builds the applications)
	sed -i 's/^\([[:space:]]*\)\(cpus\|jobs\)=\$(grep -c processor .*$/&\n\1[ -z "${UIMGUI_JOBS}" ] || \2="${UIMGUI_JOBS}"/' \
		install.sh export.sh create-project.sh UVKBuildTool/ci.sh
	grep -q UIMGUI_JOBS export.sh
}

do_build() {
	export UIMGUI_JOBS="$XBPS_MAKEJOBS"
	# Builds UVKBuildTool in UVKBuildTool/build
	./install.sh ci
	# The empty project that installs the framework
	./create-project.sh pkg --skip-compilation
	_configure_project Projects/pkg/uvproj.yaml true
}

do_install() {
	export UIMGUI_JOBS="$XBPS_MAKEJOBS"
	(cd UVKBuildTool/build && ./UVKBuildTool --build "$DESTDIR/usr" /usr ../../Projects/pkg)
	_check_installed Projects/pkg/uvproj.yaml "$DESTDIR/usr/lib"
	test -e "$DESTDIR/usr/lib/libUntitledImGuiFramework.so"
	# Only keep the framework, not the project that installed it
	rm -rf "$DESTDIR"/usr/lib/libpkgLib.so "$DESTDIR"/usr/bin/pkg "$DESTDIR"/usr/share/config/pkg \
		"$DESTDIR"/usr/include/pkg "$DESTDIR"/usr/{include,share}/utf8cpp

	# UVKBuildTool itself, built again for its system-wide location
	cmake -B "$wrksrc/uvkbuildtool-system" -S UVKBuildTool \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DUBT_INSTALL=ON \
		-DUBT_FRAMEWORK_DIR=/usr/include/UntitledImGuiFramework/ \
		-DUBT_DATA_INSTALL_PREFIX=/usr/share/
	cmake --build "$wrksrc/uvkbuildtool-system"
	DESTDIR="$DESTDIR" cmake --install "$wrksrc/uvkbuildtool-system"
	vlicense LICENSE
}

