EAPI=8

inherit go-module uimgui

DESCRIPTION="A manager for containerised Linux gaming systems based on Incus"
HOMEPAGE="https://github.com/MadLadSquad/UntitledGameSystemManager"
SRC_URI="
	https://github.com/MadLadSquad/UntitledGameSystemManager/releases/download/v2.9.1.0/untitled-game-system-manager-2.9.1.0.tar.xz -> untitled-game-system-manager-2.9.1.0.tar.xz
"
