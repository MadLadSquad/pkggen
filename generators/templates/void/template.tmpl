{#- Default pkggen template. Edit it freely: it is rendered with Jinja2 into
    srcpkgs/<name>/template on every `pkggen generate`. Distribution specific
    values come from the package's `void:` block in pkggen.yaml (`dist` here), e.g.
      void: { depends: [ glibc ], hostmakedepends: [ meson ], revision: 2 }
    `deps` holds the package's `dependencies` in Void's names (deps.hostmakedepends,
    deps.makedepends, deps.depends); the `void:` block's lists are added to them.
    `xbps_version` is the version in xbps' syntax (or `void.version`), `arches`
    the package's `architectures` in Void's names (x86_64*, aarch64*; empty for
    "any"; use `void: { archs: noarch }` for packages without compiled code).
    short_desc must be at most 72 characters, without a trailing period. -#}
# Template file for '{{ name }}'
# Generated by pkggen, edit {{ template_dir }}/template.tmpl instead
pkgname={{ name }}
version={{ xbps_version }}
revision={{ dist.revision | default(1) }}
{% set archs = dist.archs | default(arches | join(" ")) %}
{% if archs %}
archs={{ archs | dquote }}
{% endif %}
hostmakedepends={{ (deps.hostmakedepends + dist.hostmakedepends | default([])) | join(" ") | dquote }}
makedepends={{ (deps.makedepends + dist.makedepends | default([])) | join(" ") | dquote }}
depends={{ (deps.depends + dist.depends | default([])) | join(" ") | dquote }}
short_desc={{ description | default(name) | dquote }}
maintainer={{ maintainer | default("Your Name <you@example.com>") | dquote }}
license={{ license | default("custom:unknown") | spdx | dquote }}
homepage={{ homepage | default(source.url) | dquote }}
distfiles="{% for a in artifacts %}{{ a.url }}>{{ a.alias }}{% if not loop.last %} {% endif %}{% endfor %}"
checksum="{% for a in artifacts %}{{ a.checksums.sha2_256 }}{% if not loop.last %} {% endif %}{% endfor %}"

# The sources are extracted to $wrksrc{% if source is defined %} (from {{ source_dir | default(source.directory) }}){% endif %}.
# Uncomment do_build() if the package needs to be compiled.
#do_build() {
#}

do_install() {
	# Install the package's files into "$DESTDIR"
	vmkdir usr
}
