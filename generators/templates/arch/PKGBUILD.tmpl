{#- Default pkggen template. Edit it freely: it is rendered with Jinja2 into
    the Arch repository on every `pkggen generate`. Distribution specific values
    come from the package's `arch:` block in pkggen.yaml (`dist` here), e.g.
      arch: { depends: [ glibc ], makedepends: [ meson ], pkgrel: 1 }
    Keep .SRCINFO.tmpl in sync when you change fields here. -#}
# Maintainer: {{ maintainer.name | default("Your Name") }} <{{ maintainer.email | default("you@example.com") }}>
# Generated by pkggen, edit packages/arch/{{ name }}/PKGBUILD.tmpl instead

pkgname={{ name }}
pkgver={{ version | pkgver }}
pkgrel={{ dist.pkgrel | default(1) }}
pkgdesc={{ description | default(name) | dquote }}
arch=({{ dist.arch | default(["x86_64", "aarch64"]) | map("shquote") | join(" ") }})
url={{ homepage | default(source.url) | dquote }}
license=({{ license | default("LicenseRef-unknown") | spdx | shquote }})
depends=({{ dist.depends | default([]) | map("shquote") | join(" ") }})
makedepends=({{ dist.makedepends | default([]) | map("shquote") | join(" ") }})
source=(
{% for a in artifacts %}
	{{ (a.alias ~ "::" ~ a.url) | dquote }}
{% endfor %}
)
sha256sums=(
{% for a in artifacts %}
	'{{ a.checksums.sha2_256 }}'
{% endfor %}
)

# The sources are extracted to "$srcdir"{% if source is defined %} (most likely "$srcdir/{{ source_dir | default(source.directory) }}"){% endif %}.
# Uncomment build() if the package needs to be compiled.
#build() {
#}

package() {
	# Install the package's files into "$pkgdir"
	:
}
