{#- Default pkggen template. Edit it freely: it is rendered with Jinja2 into
    the Alpine repository on every `pkggen generate`. Distribution specific values
    come from the package's `alpine:` block in pkggen.yaml (`dist` here), e.g.
      alpine: { depends: [ musl ], makedepends: [ meson ], pkgrel: 1, options: "!check" }
    `deps` holds the package's `dependencies` in Alpine's names (deps.depends,
    deps.makedepends); the `alpine:` block's lists are added to them.
    `apk_version` is the version in Alpine's syntax (1.2.3_rc1, or `alpine.pkgver`),
    `arches` the package's `architectures` in Alpine's names (x86_64, aarch64
    or all; use `alpine: { arch: noarch }` for packages without compiled code). -#}
# Maintainer: {{ maintainer | default("Your Name <you@example.com>") }}
# Generated by pkggen, edit {{ template_dir }}/APKBUILD.tmpl instead
maintainer={{ maintainer | default("Your Name <you@example.com>") | dquote }}
pkgname={{ name }}
pkgver={{ apk_version }}
pkgrel={{ dist.pkgrel | default(0) }}
pkgdesc={{ description | default(name) | dquote }}
url={{ homepage | default(source.url) | dquote }}
arch={{ dist.arch | default(arches | join(" ")) | dquote }}
license={{ license | default("LicenseRef-unknown") | spdx | dquote }}
depends={{ (deps.depends + dist.depends | default([])) | join(" ") | dquote }}
makedepends={{ (deps.makedepends + dist.makedepends | default([])) | join(" ") | dquote }}
# Remove !check once check() runs the package's tests
options={{ dist.options | default("!check") | dquote }}
source="
{% for a in artifacts %}
	{{ a.alias }}::{{ a.url }}
{% endfor %}
	"
{% if source is defined %}
builddir="$srcdir"/{{ (source_dir | default(source.directory)) | dquote }}
{% endif %}

# Uncomment build() if the package needs to be compiled.
#build() {
#}

#check() {
#}

package() {
	# Install the package's files into "$pkgdir"
	mkdir -p "$pkgdir"
}

sha512sums="
{% for a in artifacts %}
{{ a.checksums.sha2_512 }}  {{ a.alias }}
{% endfor %}
"
