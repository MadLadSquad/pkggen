{#- Default pkggen template, rendered to <name>-<version>.ebuild. Distribution
    specific values come from the package's `gentoo:` block in pkggen.yaml
    (`dist` here), e.g.
      gentoo: { category: dev-libs, depend: [ dev-libs/foo ], keywords: "amd64 ~arm64" }
    `arches` is the package's `architectures` as Gentoo keywords. -#}
{% if repository.copyright is defined %}
# Copyright {{ repository.copyright.years }} {{ repository.copyright.owner }}
# Distributed under the terms of the {{ repository.copyright.license }}
{% else %}
# Copyright {{ date.year }} Gentoo Authors
# Distributed under the terms of the GNU General Public License v2
{% endif %}

EAPI=8

DESCRIPTION={{ description | default(name) | dquote }}
HOMEPAGE={{ homepage | default(source.url) | dquote }}
SRC_URI="
{% for a in artifacts %}
	{{ a.url }} -> {{ a.alias }}
{% endfor %}
"
{% set dir = source_dir | default(source.directory) %}
S="${WORKDIR}/{{ dir | replace(name ~ "-" ~ version, "${P}") }}"

LICENSE={{ license | default("all-rights-reserved") | gentoo_license | dquote }}
SLOT="0"
KEYWORDS={{ dist.keywords | default("~" ~ arches | join(" ~")) | dquote }}

DEPEND="{{ dist.depend | default([]) | join(" ") }}"
RDEPEND="${DEPEND}{% for d in dist.rdepend | default([]) %} {{ d }}{% endfor %}"
BDEPEND="{{ dist.bdepend | default([]) | join(" ") }}"

# Uncomment and fill in the phases (and add an inherit line) if the
# default ones don't build and install the package.
#src_configure() {
#}
