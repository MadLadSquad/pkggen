{#- UntitledImGuiFramework applications, built and installed by UVKBuildTool.
    Applications with extra parts extend this file and fill `build_parts`.
    Recipes are indented with tabs, and $ is $$ in them. -#}
#!/usr/bin/make -f
# Generated by pkggen, edit {{ template_dir }}/debian/rules.tmpl instead
include /usr/share/dpkg/architecture.mk
include /usr/share/dpkg/buildopts.mk
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
# The framework's build scripts run make with this many jobs (parallel=N in
# DEB_BUILD_OPTIONS; one without it, as Debian policy asks)
export UIMGUI_JOBS = $(or $(DEB_BUILD_OPTION_PARALLEL),1)
LIBDIR = lib/$(DEB_HOST_MULTIARCH)
DESTDIR = $(CURDIR)/debian/{{ name }}
{% block variables %}{% endblock %}

%:
	dh $@

override_dh_auto_configure:
	UVKBuildTool --generate "$(CURDIR)"
	sh debian/uimgui.sh configure uvproj.yaml $(LIBDIR)

override_dh_auto_build:
{% block build_parts %}
	@: UVKBuildTool builds and installs in one step, in dh_auto_install
{% endblock %}

override_dh_auto_install:
	UVKBuildTool --build $(DESTDIR)/usr /usr "$(CURDIR)"
	sh debian/uimgui.sh check uvproj.yaml $(DESTDIR)/usr/$(LIBDIR)
	# The framework's copy of utfcpp comes from libutfcpp-dev
	rm -rf $(DESTDIR)/usr/include/utf8cpp $(DESTDIR)/usr/share/utf8cpp

override_dh_auto_test:

# The UntitledDesktop libraries have no SONAME yet, so they have no shlibs file
override_dh_shlibdeps:
	dh_shlibdeps -- --ignore-missing-info

# UVKBuildTool builds without debug information
override_dh_dwz:
{% block rules %}{% endblock %}
