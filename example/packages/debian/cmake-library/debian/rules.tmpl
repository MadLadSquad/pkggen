{#- The UntitledDesktop libraries: CMake projects that install with -DUIMGUI_INSTALL=ON.
    dh's CMake build system installs to the multiarch directory. Recipes are
    indented with tabs, and $ is $$ in them. -#}
#!/usr/bin/make -f
# Generated by pkggen, edit {{ template_dir }}/debian/rules.tmpl instead
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=cmake

# Older releases install the library to lib64/ and their pkg-config file to
# lib/: use CMake's standard library directory for both, like newer ones do
execute_before_dh_auto_configure:
	grep -q 'include(GNUInstallDirs)' CMakeLists.txt || \
		sed -i '0,/^project(/s|^\(project(.*\)$$|\1\ninclude(GNUInstallDirs)|' CMakeLists.txt
	sed -i \
		-e 's|DESTINATION lib64/|DESTINATION $${CMAKE_INSTALL_LIBDIR}/|g' \
		-e 's|DESTINATION lib/pkgconfig/|DESTINATION $${CMAKE_INSTALL_LIBDIR}/pkgconfig/|g' \
		CMakeLists.txt
	sed -i 's|^libdir=.*|libdir="@CMAKE_INSTALL_FULL_LIBDIR@"|' ./*.pc.in

override_dh_auto_configure:
	dh_auto_configure -- -DUIMGUI_INSTALL=ON{% for arg in (cmake | default({})).args | default([]) %} {{ arg }}{% endfor %}

