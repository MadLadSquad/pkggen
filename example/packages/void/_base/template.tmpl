{#- Base of every UntitledDesktop xbps-src template. The folders the packages
    use (cmake-library, uimgui-app, ...) extend it: they can set
    base_hostmakedepends, base_makedepends and base_depends, and fill the
    `style` (build_style, configure_args) and `functions` blocks. The package's
    `dependencies` in pkggen.yaml (`deps`) and its own `void:` block add to the
    dependencies. xbps-src finds the shared libraries the package links against
    itself (common/shlibs). -#}
{% set hostmakedepends = base_hostmakedepends | default([]) + deps.hostmakedepends + dist.hostmakedepends | default([]) %}
{% set makedepends = base_makedepends | default([]) + deps.makedepends + dist.makedepends | default([]) %}
{% set depends = base_depends | default([]) + deps.depends + dist.depends | default([]) %}
{% set archs = dist.archs | default(arches | join(" ")) %}
# Template file for '{{ name }}'
# Generated by pkggen, edit {{ template_dir }}/template.tmpl instead
pkgname={{ name }}
version={{ xbps_version }}
revision={{ dist.revision | default(1) }}
{% if archs %}
archs={{ archs | dquote }}
{% endif %}
{% block style %}{% endblock %}
hostmakedepends={{ hostmakedepends | join(" ") | dquote }}
makedepends={{ makedepends | join(" ") | dquote }}
depends={{ depends | join(" ") | dquote }}
short_desc={{ description | dquote }}
maintainer={{ maintainer | dquote }}
license={{ license | spdx | dquote }}
homepage={{ homepage | dquote }}
distfiles="{% for a in artifacts %}{{ a.url }}>{{ a.alias }}{% if not loop.last %} {% endif %}{% endfor %}"
checksum="{% for a in artifacts %}{{ a.checksums.sha2_256 }}{% if not loop.last %} {% endif %}{% endfor %}"
{% block functions %}{% endblock %}
