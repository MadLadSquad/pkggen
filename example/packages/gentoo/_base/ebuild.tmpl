{#- Base of every ebuild of the overlay. The folders the packages use extend it:
    they set `inherit` and base_depend/base_rdepend/base_bdepend and fill the
    `functions` block. The package's `dependencies` in pkggen.yaml (`deps`) add
    to them, and its own `gentoo:` block adds `depend`, `rdepend`, `bdepend`,
    `iuse`, `keywords` and `license`. -#}
{% set depend = base_depend | default([]) + deps.depend + dist.depend | default([]) %}
{% set rdepend = base_rdepend | default([]) + deps.rdepend + dist.rdepend | default([]) %}
{% set bdepend = base_bdepend | default([]) + deps.bdepend + dist.bdepend | default([]) %}
{% macro atoms(list) %}{% for atom in list %}{{ "\n\t" if not loop.first else "" }}{{ atom }}{% endfor %}{% endmacro %}
# Copyright {{ repository.copyright.years }} {{ repository.copyright.owner }}
# Distributed under the terms of the {{ repository.copyright.license }}
# Generated by pkggen, edit {{ template_dir }}/ebuild.tmpl instead

EAPI=8
{% if inherit | default([]) %}

inherit {{ inherit | join(" ") }}
{% endif %}

DESCRIPTION={{ description | dquote }}
HOMEPAGE={{ homepage | dquote }}
SRC_URI="
{% for a in artifacts %}
	{{ a.url }} -> {{ a.alias }}
{% endfor %}
"
{% block source_dir %}
{% set dir = source_dir | default(source.directory) %}
S="${WORKDIR}/{{ dir | replace(name ~ "-" ~ version, "${P}") }}"
{% endblock %}

LICENSE={{ dist.license | default(license | gentoo_license) | dquote }}
SLOT="0"
KEYWORDS={{ dist.keywords | default("~" ~ arches | join(" ~")) | dquote }}
{% if dist.iuse is defined %}
IUSE={{ dist.iuse | dquote }}
{% endif %}
{% block fields %}{% endblock %}

{% if depend %}
DEPEND="{{ atoms(depend) }}"
{% endif %}
{% if rdepend or depend %}
RDEPEND="{{ "${DEPEND}" if depend else "" }}{{ ("\n\t" if depend else "") ~ atoms(rdepend) if rdepend else "" }}"
{% endif %}
{% if bdepend %}
BDEPEND="{{ atoms(bdepend) }}"
{% endif %}
{% block functions %}{% endblock %}
