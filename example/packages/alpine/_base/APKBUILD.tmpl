{#- Base of every UntitledDesktop APKBUILD. The folders the packages use
    (cmake-library, uimgui-app, ...) extend it: they can set base_depends and
    base_makedepends and fill the `functions` block. The package's
    `dependencies` in pkggen.yaml (`deps`) and its own `alpine:` block add to
    the dependencies. abuild finds the shared libraries the package links
    against (so:) and installs build-base (the compilers) itself. The scripts
    use GNU sed's extensions (busybox's sed doesn't have them). -#}
{% set depends = base_depends | default([]) + deps.depends + dist.depends | default([]) %}
{% set makedepends = ["sed"] + base_makedepends | default([]) + deps.makedepends + dist.makedepends | default([]) %}
# Maintainer: {{ maintainer }}
# Generated by pkggen, edit {{ template_dir }}/APKBUILD.tmpl instead
maintainer={{ maintainer | dquote }}
pkgname={{ name }}
pkgver={{ apk_version }}
pkgrel={{ dist.pkgrel | default(0) }}
pkgdesc={{ description | dquote }}
url={{ homepage | dquote }}
arch={{ dist.arch | default(arches | join(" ")) | dquote }}
license={{ license | spdx | dquote }}
depends={{ depends | join(" ") | dquote }}
makedepends={{ makedepends | join(" ") | dquote }}
# Upstream has no tests
options={{ dist.options | default("!check") | dquote }}
{% block fields %}{% endblock %}
source="
{% for a in artifacts %}
	{{ a.alias }}::{{ a.url }}
{% endfor %}
	"
builddir="$srcdir"/{{ (source_dir | default(source.directory)) | dquote }}
{% block functions %}{% endblock %}

sha512sums="
{% for a in artifacts %}
{{ a.checksums.sha2_512 }}  {{ a.alias }}
{% endfor %}
"
