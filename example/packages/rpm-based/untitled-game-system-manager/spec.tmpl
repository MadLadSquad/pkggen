{#- An UntitledImGuiFramework application with Go bindings to Incus (vendored modules). -#}
{% extends "uimgui-app/spec.tmpl" %}
{% block build_parts %}
# The Incus bindings: a C shared library written in Go
(cd IncusBindings && go build -mod=vendor -trimpath -buildmode=c-shared -o libUGM_Incus_InternalFuncs.so .)
{% endblock %}
