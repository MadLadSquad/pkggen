{#- Base of every UntitledDesktop spec, for Fedora, openSUSE and OpenMandriva.
    The folders the packages use extend it: they set base_build_requires and
    base_requires and fill the blocks. The package's `dependencies` in
    pkggen.yaml (`deps`, with the ones the families name differently in
    deps.by_family) add to them, and its own `rpm-based:` block adds
    `build-requires`, `requires` and `files`. Write macros in comments as %% so
    they aren't expanded. -#}
{% set build_requires = base_build_requires | default([]) + deps.build_requires + dist["build-requires"] | default([]) %}
{% set requires = base_requires | default([]) + deps.requires + dist.requires | default([]) %}
# Generated by pkggen, edit {{ template_dir }}/spec.tmpl instead
{% block globals %}{% endblock %}
Name:           {{ name }}
Version:        {{ version | pkgver }}
Release:        {{ dist.release | default(1) }}%{?dist}
Summary:        {{ description }}
License:        {{ license | spdx }}
URL:            {{ homepage }}
{% for a in artifacts %}
Source{{ loop.index0 }}:        {{ a.url }}#/{{ a.alias }}
{% endfor %}
{% if arches %}
ExclusiveArch:  {{ arches | join(" ") }}
{% endif %}

{% for d in build_requires %}
BuildRequires:  {{ d }}
{% endfor %}
{% for d in requires %}
Requires:       {{ d }}
{% endfor %}
{% for f in deps.by_family %}
%if {{ f.condition }}
{% for d in f.build_requires %}
BuildRequires:  {{ d }}
{% endfor %}
{% for d in f.requires %}
Requires:       {{ d }}
{% endfor %}
%endif
{% endfor %}

%description
{{ description }}.

%prep
%autosetup -n {{ source_dir | default(source.directory) }}
{% block prep %}{% endblock %}

%build
{% block build %}{% endblock %}

%install
{% block install %}{% endblock %}

%files
%license LICENSE
{% block files %}
{% for f in dist.files | default([]) %}
{{ f }}
{% endfor %}
{% endblock %}

%changelog
* {{ date | rpmdate }} {{ maintainer }} - {{ version | pkgver }}-{{ dist.release | default(1) }}
- Update to {{ version }}
