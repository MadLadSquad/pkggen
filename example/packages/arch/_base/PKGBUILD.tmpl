{#- Base of every UntitledDesktop PKGBUILD. The folders the packages use
    (cmake-library, uimgui-app, ...) extend it: they set base_depends and
    base_makedepends and fill the `functions` block. The package's
    `dependencies` in pkggen.yaml (`deps`) and its own `arch:` block add to the
    dependencies. Keep .SRCINFO.tmpl in sync. -#}
{% set depends = base_depends | default([]) + deps.depends + dist.depends | default([]) %}
{% set makedepends = base_makedepends | default([]) + deps.makedepends + dist.makedepends | default([]) %}
# Maintainer: {{ maintainer }}
# Generated by pkggen, edit {{ template_dir }}/PKGBUILD.tmpl instead

pkgname={{ name }}
pkgver={{ version | pkgver }}
pkgrel={{ dist.pkgrel | default(1) }}
pkgdesc={{ description | dquote }}
arch=({{ dist.arch | default(arches) | map("shquote") | join(" ") }})
url={{ homepage | dquote }}
license=({{ license | spdx | shquote }})
depends=({{ depends | map("shquote") | join(" ") }})
makedepends=({{ makedepends | map("shquote") | join(" ") }})
{% block fields %}{% endblock %}
source=(
{% for a in artifacts %}
	{{ (a.alias ~ "::" ~ a.url) | dquote }}
{% endfor %}
)
sha256sums=(
{% for a in artifacts %}
	'{{ a.checksums.sha2_256 }}'
{% endfor %}
)
{% block functions %}{% endblock %}
