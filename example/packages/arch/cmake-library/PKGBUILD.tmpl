{#- The UntitledDesktop libraries: CMake projects that install with -DUIMGUI_INSTALL=ON.
    Extra CMake options come from the package's `cmake: { args: [...] }` in pkggen.yaml. -#}
{% extends "_base/PKGBUILD.tmpl" %}
{% set base_depends = ["gcc-libs", "glibc"] %}
{% set src = "$srcdir/" ~ (source_dir | default(source.directory)) %}
{% block functions %}

prepare() {
	cd "{{ src }}"
	# Older releases install the library to lib64/ and their pkg-config file
	# to lib/: use CMake's standard library directory for both, like newer ones do
	grep -q 'include(GNUInstallDirs)' CMakeLists.txt ||
		sed -i '0,/^project(/s|^\(project(.*\)$|\1\ninclude(GNUInstallDirs)|' CMakeLists.txt
	sed -i \
		-e 's|DESTINATION lib64/|DESTINATION ${CMAKE_INSTALL_LIBDIR}/|g' \
		-e 's|DESTINATION lib/pkgconfig/|DESTINATION ${CMAKE_INSTALL_LIBDIR}/pkgconfig/|g' \
		CMakeLists.txt
	sed -i 's|^libdir=.*|libdir="@CMAKE_INSTALL_FULL_LIBDIR@"|' ./*.pc.in
}

build() {
	cmake -B build -S "{{ src }}" \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DUIMGUI_INSTALL=ON{% for arg in (cmake | default({})).args | default([]) %} \
		{{ arg | shquote }}{% endfor %}

	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	install -Dm644 "{{ src }}/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
{% endblock %}
